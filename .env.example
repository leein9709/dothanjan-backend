NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=dothanjan
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=dothanjan
DATABASE_URL=postgresql://dothanjan:replace-with-a-local-random-password@127.0.0.1:54329/dothanjan
# Keep loopback unless intentionally testing from a phone on your private LAN.
API_BIND_ADDRESS=127.0.0.1

# Keep actual Kakao values only in the ignored .env file.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_APP_ID=
KAKAO_REDIRECT_URI=http://127.0.0.1:3000/v1/auth/kakao/callback

# Keep actual Naver values only in the ignored .env file.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://127.0.0.1:3000/v1/auth/naver/callback

# Generate 32 random bytes as 64 hexadecimal characters. Keep stable and Git-excluded.
SESSION_ROTATION_KEY=
