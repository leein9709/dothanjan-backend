{
  "name": "dothanjan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": { "fastify": "5.12.5", "pg": "8.23.1" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/pg": "^8.0.0", "tsx": "4.23.15", "typescript": "7.0.2" }
}
